@model List<wt_lab4_4mvc_gerasimchuk.Models.Flight>
@{ ViewData["Title"] = "Рейсы"; }

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Расписание рейсов</h1>
            <p class="text-muted">Авиакомпания SkyLine — управление рейсами</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">Добавить рейс</a>
    </div>
    <div class="row g-4">
        @foreach (var flight in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm rounded-4">
                    <div class="card-body">
                        <span class="badge bg-secondary mb-2">ID: @flight.Id</span>
                        <h5 class="card-title">@flight.FlightNumber</h5>
                        <p class="mb-1 fw-semibold">@flight.DepartureCity → @flight.ArrivalCity</p>
                        <p class="text-muted small mb-2">@flight.DepartureTime.ToString("dd.MM.yyyy HH:mm") — @flight.ArrivalTime.ToString("dd.MM.yyyy HH:mm")</p>
                        <p class="fs-4 fw-bold">@flight.Price ₽</p>
                        @if (flight.IsAvailable) { <span class="badge bg-success">Доступен</span> }
                        else { <span class="badge bg-danger">Нет мест</span> }
                        <div class="mt-3 d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@flight.Id" class="btn btn-outline-primary btn-sm">Подробнее</a>
                            <a asp-action="Edit" asp-route-id="@flight.Id" class="btn btn-outline-secondary btn-sm">Редактировать</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>